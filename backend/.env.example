# ============================================
# Mini ERP + CRM Backend — Environment Variables
# ============================================
# Copy this file to .env and fill in real values.
# NEVER commit the .env file to version control.

# Server
PORT=3001
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE_NAME?schema=public

# JWT Authentication
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_STRING
JWT_EXPIRES_IN=24h

# CORS — Allowed Origins (comma-separated for multiple)
# Use * for development. In production, set to your frontend domain.
# Example: https://yourdomain.com,https://www.yourdomain.com
CORS_ORIGIN=*

# AWS S3 Configuration (Product Image Upload)
AWS_REGION=us-east-1
AWS_S3_BUCKET=my-product-images-bucket
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key

